# Sanity — from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-27

# Server-only. A write token, used only by seed/write scripts — never read at runtime.
# Never prefix this with NEXT_PUBLIC_ — that would ship it to the browser.
SANITY_API_WRITE_TOKEN=

# Server-only. A Viewer token, needed once draft mode / preview is built.
SANITY_API_READ_TOKEN=

# Absolute URL, for canonical links, OG images, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://akashsharma.dev
